\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerouterthemeXYJ}

\RequirePackage{graphicx}
\RequirePackage{pgffor}
\RequirePackage{etoolbox}
\RequirePackage{adjustbox}
\RequirePackage{tikz}

\newif\ifxyjshowdots
\xyjshowdotstrue
\newcommand{\xyjnavdots}[1]{%
  \ifstrequal{#1}{true}{\xyjshowdotstrue}{\xyjshowdotsfalse}%
}

\newcounter{xyjsectioncount}
\newcounter{xyjsection}
\newcounter{xyjdot}
\newlength{\xyjnavwidth}
\def\xyjnavitems{}
\def\xyjnavfont{\fontsize{5}{5.7}\selectfont}

\newcommand{\xyjnavcount}[1]{%
  \setcounter{xyjsectioncount}{#1}%
  \ifnum#1>0
    \setlength{\xyjnavwidth}{\dimexpr(\paperwidth-1.45cm)/#1\relax}%
  \else
    \setlength{\xyjnavwidth}{0pt}%
  \fi
  \ifnum#1>8
    \def\xyjnavfont{\fontsize{5}{5.7}\selectfont}%
  \else
    \ifnum#1>5
      \def\xyjnavfont{\fontsize{5}{5.7}\selectfont}%
    \else
      \def\xyjnavfont{\fontsize{5}{5.7}\selectfont}%
    \fi
  \fi
}

\newcommand{\xyjnavbullet}[1]{%
  \tikz[baseline=-0.12ex]{\fill[#1] (0,0) circle (0.3125mm);}%
}

\newcommand{\xyjnavdotrow}[2]{%
  \ifxyjshowdots
    \ifnum#2>0
      \foreach \xyjdotindex in {1,...,#2}{%
        \ifnum#1=\value{xyjsection}\relax
          \ifnum\xyjdotindex=\value{xyjdot}\relax
            \xyjnavbullet{xyjAccent}%
          \else
            \xyjnavbullet{white!45!xyjPrimary}%
          \fi
        \else
          \xyjnavbullet{white!45!xyjPrimary}%
        \fi
        \hspace{0.5mm}%
      }%
    \fi
  \fi
}

\newcommand{\xyjnavitemrender}[3]{%
  \makebox[\xyjnavwidth][c]{%
    \shortstack{%
      {\adjustbox{max width=\dimexpr\xyjnavwidth-0.08cm\relax}{%
        \xyjnavfont\ifnum#1=\value{xyjsection}\relax\color{white}\bfseries\else\color{white!78!xyjPrimary}\mdseries\fi #2}}\\[0.35mm]%
      \xyjnavdotrow{#1}{#3}%
    }%
  }%
}

\newcommand{\xyjnavsection}[3]{%
  \appto\xyjnavitems{\xyjnavitemrender{#1}{#2}{#3}}%
}

\setbeamertemplate{headline}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=0.65cm,dp=0cm]{headline}%
    \vbox to 0.65cm{\vfil
      \hbox to\paperwidth{%
        \hspace*{0.5cm}\xyjnavitems\hfill
        \raisebox{-0.02cm}{\includegraphics[height=0.375cm]{assets/whu-logo-white.png}}%
        \hspace*{0.5cm}%
      }%
    \vfil}%
  \end{beamercolorbox}%
}

\newif\ifxyjshowfooter
\xyjshowfootertrue
\newif\ifxyjshowpage
\xyjshowpagetrue
\newcounter{xyjpage}
\def\xyjpresentername{}
\def\xyjcoursename{}
\def\xyjtotalpagecount{0}

\newcommand{\xyjpresenter}[1]{\def\xyjpresentername{#1}}
\newcommand{\xyjcourse}[1]{\def\xyjcoursename{#1}}
\newcommand{\xyjtotalpages}[1]{\def\xyjtotalpagecount{#1}}
\newcommand{\xyjnofooter}{\xyjshowfooterfalse}
\newcommand{\xyjfooter}{\xyjshowfootertrue}
\newcommand{\xyjnopage}{\xyjshowpagefalse}
\newcommand{\xyjpage}{\xyjshowpagetrue}

\setbeamertemplate{footline}{%
  \ifxyjshowfooter
    \vbox{%
      \hrule height 0.125mm width\paperwidth
      \vspace*{0.45mm}%
      \hbox to\paperwidth{%
        \hspace*{5mm}%
        \makebox[35mm][l]{\usebeamerfont{footline}\color{xyjMuted}\xyjpresentername}%
        \hfill
        {\setlength{\fboxsep}{0.6mm}%
         \colorbox{xyjSoft}{\makebox[30mm][c]{\usebeamerfont{footline}\color{xyjText}\xyjcoursename}}}%
        \hfill
        \makebox[35mm][r]{%
          \ifxyjshowpage
            {\usebeamerfont{footline}\color{xyjMuted}\thexyjpage/\xyjtotalpagecount}%
          \fi
        }%
        \hspace*{5mm}%
      }%
      \vspace*{0.35mm}%
    }%
  \fi
}

\setbeamertemplate{frametitle}{%
  \vspace*{-2.4mm}%
  \noindent\begin{minipage}[t]{\textwidth}%
    \usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle%
  \end{minipage}\par
  \vspace*{-0.5mm}%
}

\setbeamertemplate{navigation symbols}{}
\setbeamersize{text margin left=8mm,text margin right=8mm}

\endinput
