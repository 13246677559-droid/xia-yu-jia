\definecolor{xyjText}{HTML}{1F2328}
\definecolor{xyjMuted}{HTML}{5F6368}
\definecolor{xyjFootnote}{HTML}{8A9099}
\definecolor{xyjEndTan}{HTML}{D8A47F}
\definecolor{xyjDivider}{HTML}{C1C6C8}

\setbeamercolor{normal text}{fg=xyjText,bg=white}
\setbeamercolor{structure}{fg=xyjPrimary}
\setbeamercolor{frametitle}{fg=xyjText,bg=white}
\setbeamercolor{headline}{fg=white,bg=xyjPrimary}
\setbeamercolor{footline}{fg=xyjMuted,bg=white}
\setbeamercolor{section in toc}{fg=xyjText}
\setbeamercolor{section number projected}{bg=xyjPrimary,fg=white}
\setbeamercolor{subsection in toc}{fg=xyjMuted}
\setbeamercolor{itemize item}{fg=xyjAccent}
\setbeamercolor{itemize subitem}{fg=xyjAccent}
\setbeamercolor{block title}{fg=white,bg=xyjPrimary}
\setbeamercolor{block body}{fg=xyjText,bg=xyjTint}
\setbeamercolor{xyjupperprimary}{fg=white,bg=xyjPrimary}
\setbeamercolor{xyjupperaccent}{fg=xyjOnAccent,bg=xyjAccent}
\setbeamercolor{xyjlower}{fg=xyjText,bg=xyjTint}
\setbeamercolor{coverband}{fg=white,bg=xyjPrimary}
\setbeamercolor{caption name}{fg=xyjMuted}

